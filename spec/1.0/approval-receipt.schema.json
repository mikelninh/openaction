{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://raw.githubusercontent.com/mikelninh/openaction/main/spec/1.0/approval-receipt.schema.json","title":"OpenAction Approval Receipt 1.0 RC1","type":"object","additionalProperties":false,"required":["version","id","decision","scope","approver","decided_at","evidence_snapshot","conditions"],"properties":{"version":{"const":"openaction-receipt/1.0-rc1"},"id":{"type":"string","pattern":"^oar_[A-Za-z0-9._-]+$"},"decision":{"enum":["approved","rejected","revoked"]},"scope":{"type":"object","additionalProperties":false,"required":["subject","environment"],"properties":{"subject":{"type":"string","minLength":1},"environment":{"enum":["sandbox","pilot","production"]},"organisation":{"type":"string"},"use_case":{"type":"string"},"version":{"type":"string"}}},"approver":{"type":"object","additionalProperties":false,"required":["type","id","role"],"properties":{"type":{"enum":["human","qualified_human","institution"]},"id":{"type":"string"},"role":{"type":"string"},"identity_provider":{"type":"string"}}},"decided_at":{"type":"string","format":"date-time"},"expires_at":{"type":"string","format":"date-time"},"conditions":{"type":"array","items":{"type":"string"}},"reason":{"type":"string","maxLength":1200},"evidence_snapshot":{"type":"object","additionalProperties":false,"required":["sha256","items"],"properties":{"sha256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},"items":{"type":"array","items":{"type":"string"}}}},"proof":{"type":"object","additionalProperties":false,"properties":{"type":{"enum":["none","external_jws","organisational_signature","qualified_electronic_signature","other"]},"verification_method":{"type":"string"},"value":{"type":"string"},"verified_at":{"type":"string","format":"date-time"}}},"supersedes":{"type":"string","pattern":"^oar_[A-Za-z0-9._-]+$"}}}