{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://raw.githubusercontent.com/mikelninh/openaction/main/spec/1.0/change-impact.schema.json","title":"OpenAction Change Impact 1.0 RC1","type":"object","additionalProperties":false,"required":["version","id","subject","changes","gate_impacts","generated_at"],"properties":{"version":{"const":"openaction-change/1.0-rc1"},"id":{"type":"string","pattern":"^oac_[A-Za-z0-9._-]+$"},"subject":{"type":"string"},"changes":{"type":"array","minItems":1,"items":{"type":"object","required":["dimension","before","after"],"properties":{"dimension":{"enum":["purpose","data","model","vendor","hosting","workflow","permission","law","identity","security_control"]},"before":{},"after":{},"reason":{"type":"string"}}}},"gate_impacts":{"type":"array","items":{"type":"object","required":["gate_id","impact","reason"],"properties":{"gate_id":{"type":"string","pattern":"^gate_[A-Za-z0-9._-]+$"},"impact":{"enum":["unchanged","verify","reopen"]},"reason":{"type":"string"}}}},"generated_at":{"type":"string","format":"date-time"},"human_review_required":{"type":"boolean"}}}